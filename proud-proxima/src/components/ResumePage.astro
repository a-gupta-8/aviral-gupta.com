---
import BackButton from './BackButton.jsx';  
---

<div>
    <BackButton page="<" href="/" client:load/>
    <iframe src="/Aviral_Gupta_Resume.pdf"
            width="33.5%"
            height="1100"
            class="resume-iframe"
            title="PDF Viewer">
    </iframe>
</div>

<style>
.resume-iframe {
    border: none;
    display: block;
    margin: 50px auto 0;
}

@media (max-width: 768px) {
    .resume-iframe {
        width: 100%;
        height: 100vh;
        margin-top: 50px;
    }
}
</style>