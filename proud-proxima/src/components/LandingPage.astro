---
import Title from '../components/TitleText.jsx';
import NavBox from './NavBox.jsx';  
---

<div class="landing">
    <Title client:load />
    <div class="navigator">
        <NavBox page="Resume" href="/resume" client:load/>
    </div>
</div>



<style>

    .landing {
        display: flex;
        flex-direction: column;       /* Stack elements vertically */
        justify-content: center;      /* Center vertically */
        align-items: center;          /* Center horizontally */
        width: 100%;                  /* Full width */
        height: 100vh;                /* Full viewport height */
        transform: translateY(-5vh);
    }

    .landing > * {
        text-align: center;
        margin: 0;
    }

    .navigator {
        position: relative;
        top: 10px;

        display: flex;
        gap: 150px;
    }


</style>